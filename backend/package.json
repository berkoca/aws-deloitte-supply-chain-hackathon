{
  "name": "optisupply-backend",
  "version": "0.1.0",
  "description": "OptiSupply digital twin backend: Strands multi-agent on Amazon Bedrock",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsc -p tsconfig.json && (tsc -p tsconfig.json --watch --preserveWatchOutput & node --env-file-if-exists=.env --watch dist/main.js)",
    "test": "node --test test/*.test.mjs"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1177.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1177.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1177.0",
    "@aws-sdk/client-dynamodb": "^3.1177.0",
    "@aws-sdk/client-polly": "^3.1177.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1177.0",
    "@aws-sdk/lib-dynamodb": "^3.1177.0",
    "@aws/aws-distro-opentelemetry-node-autoinstrumentation": "^0.15.0",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@strands-agents/sdk": "^1.26.0",
    "bedrock-agentcore": "^0.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@types/node": "^26.6.10",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true
}
